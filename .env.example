# Copy to .env and fill in. Only GOOGLE_PLACES_API_KEY is required.

# Google Maps listings, hours, 5 reviews per business (required)
# https://console.cloud.google.com/apis/library/places.googleapis.com
GOOGLE_PLACES_API_KEY=

# Full review history, which is where "never called back" complaints hide (optional, recommended)
# https://app.outscraper.com/profile  (API key in Profile)
OUTSCRAPER_API_KEY=

# Owner/office emails by domain (optional)
# https://hunter.io/api-keys
HUNTER_API_KEY=

# Build per-prospect demo assistants (optional)
# https://dashboard.vapi.ai  → Org settings → API keys (use the PRIVATE key)
VAPI_API_KEY=
VAPI_DEMO_PHONE_NUMBER_ID=

# Used in the generated cold emails
SENDER_NAME=Khalil
SENDER_COMPANY=Scalepath Partnership
CALENDLY_LINK=https://calendly.com/your-link
