# One free key is enough. If you set more than one they are tried in this order,
# so a rate limit on the first falls through to the next instead of failing.

# console.groq.com/keys      — fastest responses, best for the phone agent
GROQ_API_KEY=

# aistudio.google.com/apikey — most generous daily allowance
GEMINI_API_KEY=

# openrouter.ai/keys         — backup, free models
OPENROUTER_API_KEY=

# Override a model if a provider's console says the default is gone:
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_MODEL=gemini-2.0-flash
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
